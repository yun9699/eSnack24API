<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.esnack24api.esnack24api.order.mapper.OrderMapper">

    <select id="getOrderView" resultType="OrderViewDTO">
        select
            total_amount, currency
        from
            tbl_order
        where
            ono = #{ono}
    </select>

    <select id="getOrderDetail" resultType="OrderDetailDTO">
        select
            oip.pno, oip.ptitle_ko, oip.pfilename, oip.price, oip.oiqty, o.total_amount
        from
            tbl_order o
            left join
                (select
                    oi.ono, oi.oiqty,
                    p.pno, p.ptitle_ko, p.pfilename, p.price
                from
                    tbl_order_item oi left join tbl_product p on oi.pno = p.pno
                ) oip on oip.ono = o.ono
        where
            o.ono = #{ono}
    </select>

