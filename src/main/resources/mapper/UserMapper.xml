<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.esnack24api.esnack24api.user.mapper.UserMapper">

    <resultMap id="personalAnosMap" type="UserAnosDTO">
        <id property="uno" column="uno"/>
        <collection property="anos" ofType="java.lang.Long">
            <result column="ano" />
        </collection>
    </resultMap>

    <select id="getUserAnos" resultMap="personalAnosMap">
        select
            uno, ano
        from
            tbl_user_allergy
        where
            uno = #{uno}
    </select>


</mapper>