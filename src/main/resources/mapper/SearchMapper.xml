<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.esnack24api.esnack24api.search.mapper.ProductSearchMapper">

    <select id="getSearchList" resultType="ProductSearchDTO">
        select
            pno, price, ptitle_ko, pfilename
        from
            tbl_product
        where
            ptitle_ko LIKE CONCAT('%',#{ptitle_ko}, '%')
        and
            pdelete = 0
        order by
            ptitle_ko
    </select>

</mapper>